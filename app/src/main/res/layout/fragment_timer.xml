<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:padding="24dp">

    <!-- Focus Mode Status Pill -->
    <TextView
        android:id="@+id/tv_timer_session_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rounded_pill"
        android:backgroundTint="@color/md_theme_tertiaryContainer"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        android:text="@string/timer_state_work"
        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
        android:textColor="@color/md_theme_onTertiaryContainer"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Timer Countdown Circle Display -->
    <FrameLayout
        android:id="@+id/frame_timer_circle"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_marginTop="36dp"
        app:layout_constraintTop_toBottomOf="@id/tv_timer_session_state"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress_timer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:progress="100"
            app:indicatorColor="@color/md_theme_tertiary"
            app:indicatorSize="260dp"
            app:trackColor="@color/md_theme_surfaceVariant"
            app:trackCornerRadius="8dp"
            app:trackThickness="12dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_timer_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/timer_default_display"
                android:textAppearance="@style/TextAppearance.Material3.DisplayLarge"
                android:textColor="@color/md_theme_onBackground"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_timer_task_linked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/timer_selected_task"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/md_theme_onSurfaceVariant" />
        </LinearLayout>
    </FrameLayout>

    <!-- Controls Row (Start/Pause, Reset) -->
    <LinearLayout
        android:id="@+id/layout_timer_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/frame_timer_circle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_timer_reset"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginEnd="12dp"
            android:text="@string/timer_btn_reset" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_timer_toggle"
            android:layout_width="160dp"
            android:layout_height="52dp"
            android:text="@string/timer_btn_start"
            app:backgroundTint="@color/md_theme_tertiary" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
